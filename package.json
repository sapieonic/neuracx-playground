{
  "name": "neuracx-quick-enabler",
  "version": "1.0.0",
  "description": "Test WebSocket server for NeuraCX inbound call streaming, with Gemini Live as the voice bot",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  }
}
