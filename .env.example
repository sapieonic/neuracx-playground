# Gemini API key from https://aistudio.google.com/apikey (can also be set in the UI)
GEMINI_API_KEY=

PORT=8080

# Optional: NeuraCX must then connect to wss://<host>/stream?token=<STREAM_TOKEN>
STREAM_TOKEN=

# Password for the UI (any username). Required in Docker / NODE_ENV=production;
# optional for local `npm start`.
UI_PASSWORD=

# Optional: most calls at once (default 20); more stream connections get 503
MAX_CALLS=
